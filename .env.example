# ─────────────────────────────────────────────────────
# Banking DSA CRM — Environment Configuration Template
# Copy to .env and fill in your values
# ─────────────────────────────────────────────────────

# Flask
FLASK_APP=wsgi.py
FLASK_ENV=development
SECRET_KEY=change-me-to-a-random-64-char-string

# Database (PostgreSQL)
DATABASE_URL=postgresql://loanaxis:loanaxis@localhost:5432/loanaxis_crm
# SQLite fallback for local dev (uncomment to use):
# DATABASE_URL=sqlite:///instance/loanaxis.db

# Redis
REDIS_URL=redis://localhost:6379/0

# Flask-Mail (SMTP)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=noreply@loanaxis.com

# Security
BCRYPT_LOG_ROUNDS=12
JWT_SECRET_KEY=change-me-to-another-random-string
JWT_ACCESS_TOKEN_EXPIRES=900
JWT_REFRESH_TOKEN_EXPIRES=604800

# File Uploads
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=10485760

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Agency Details (for invoices)
AGENCY_NAME=LoanAxis Financial Services
AGENCY_GSTIN=
AGENCY_ADDRESS=
AGENCY_PAN=
AGENCY_LOGO_PATH=app/static/img/logo.svg
